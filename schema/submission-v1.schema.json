{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-4-h.org/schemas/evaluation-submission-v1.json",
  "title": "AI4H Evaluation Submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "submissionId", "submittedAt", "organization", "app", "consent", "provenance", "run"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "submissionId": { "type": "string", "format": "uuid" },
    "submittedAt": { "type": "string", "format": "date-time" },
    "organization": { "const": "Safe AI for Humanity Foundation" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "AI4H Eval Lab" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicRelease", "includeRawResponses", "includeReviews"],
      "properties": {
        "publicRelease": { "const": true },
        "includeRawResponses": { "const": true },
        "includeReviews": { "const": true }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submitter": { "type": "string", "minLength": 1, "maxLength": 120 },
        "notes": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "run": { "$ref": "#/$defs/run" }
  },
  "$defs": {
    "provider": {
      "enum": ["ollama", "openrouter", "kie", "openai", "anthropic", "gemini", "openai-compatible"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": { "$ref": "#/$defs/provider" },
        "model": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "user", "assistant"] },
        "content": { "type": "string", "minLength": 1, "maxLength": 20000 }
      }
    },
    "evaluator": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "values"],
          "properties": {
            "type": { "const": "contains_any" },
            "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "caseSensitive": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "values"],
          "properties": {
            "type": { "const": "contains_none" },
            "values": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "caseSensitive": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "pattern"],
          "properties": {
            "type": { "const": "regex" },
            "pattern": { "type": "string" },
            "flags": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "const": "non_empty" },
            "minimumCharacters": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "valid_json" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "rubric"],
          "properties": {
            "type": { "const": "human_review" },
            "rubric": { "type": "string", "minLength": 10, "maxLength": 1000 }
          }
        }
      ]
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator", "status", "explanation"],
      "properties": {
        "evaluator": { "$ref": "#/$defs/evaluator" },
        "status": { "enum": ["pass", "fail", "review"] },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reviewerType", "verdict", "reviewedAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reviewerType": { "const": "human" },
        "verdict": { "enum": ["pass", "fail"] },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string", "minLength": 1, "maxLength": 10000 }
      }
    },
    "modelReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reviewerType", "verdict", "reviewedAt", "rationale", "provider", "model", "rawResponse"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "reviewerType": { "const": "model" },
        "verdict": { "enum": ["pass", "fail"] },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "provider": { "$ref": "#/$defs/provider" },
        "model": { "type": "string", "minLength": 1, "maxLength": 300 },
        "rawResponse": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "promptTokens": { "type": "integer", "minimum": 0 },
        "completionTokens": { "type": "integer", "minimum": 0 }
      }
    },
    "suiteSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title", "category", "risk", "contentHash"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "category": { "type": "string", "minLength": 3, "maxLength": 100 },
        "risk": { "enum": ["low", "moderate", "high"] },
        "contentHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "suiteId", "suiteVersion", "suiteHash", "caseId", "caseTitle", "caseMessages", "target", "response", "startedAt", "completedAt", "latencyMs", "outcomes", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "suiteId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "suiteVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "suiteHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "caseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "caseTitle": { "type": "string", "minLength": 3, "maxLength": 120 },
        "caseMessages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/message" } },
        "target": { "$ref": "#/$defs/target" },
        "response": { "type": "string", "maxLength": 200000 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "latencyMs": { "type": "integer", "minimum": 0 },
        "promptTokens": { "type": "integer", "minimum": 0 },
        "completionTokens": { "type": "integer", "minimum": 0 },
        "outcomes": { "type": "array", "items": { "$ref": "#/$defs/outcome" } },
        "status": { "enum": ["pass", "fail", "review", "error"] },
        "error": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "reviews": {
          "type": "array",
          "items": { "oneOf": [{ "$ref": "#/$defs/humanReview" }, { "$ref": "#/$defs/modelReview" }] }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "createdAt", "completedAt", "status", "suiteSnapshots", "targets", "results"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "status": { "const": "completed" },
        "suiteSnapshots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/suiteSnapshot" } },
        "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
        "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/result" } }
      }
    }
  }
}
