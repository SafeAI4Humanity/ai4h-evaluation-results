{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-4-h.org/schemas/evaluation-submission-v2.json",
  "title": "AI4H Evaluation Submission with Multi-turn Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "submissionId", "submittedAt", "organization", "app", "consent", "provenance", "run"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "submissionId": { "type": "string", "format": "uuid" },
    "submittedAt": { "type": "string", "format": "date-time" },
    "organization": { "const": "Safe AI for Humanity Foundation" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "AI4H Eval Lab" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicRelease", "includeRawResponses", "includeReviews"],
      "properties": {
        "publicRelease": { "const": true },
        "includeRawResponses": { "const": true },
        "includeReviews": { "const": true }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "submitter": { "type": "string", "minLength": 1, "maxLength": 120 },
        "notes": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "run": { "$ref": "#/$defs/run" }
  },
  "$defs": {
    "turnResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnId", "turnTitle", "turnNumber", "prompt", "response", "startedAt", "completedAt", "latencyMs", "outcomes", "status"],
      "properties": {
        "turnId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "turnTitle": { "type": "string", "minLength": 3, "maxLength": 120 },
        "turnNumber": { "type": "integer", "minimum": 1, "maximum": 8 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "response": { "type": "string", "maxLength": 200000 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "latencyMs": { "type": "integer", "minimum": 0 },
        "promptTokens": { "type": "integer", "minimum": 0 },
        "completionTokens": { "type": "integer", "minimum": 0 },
        "outcomes": { "type": "array", "items": { "$ref": "https://ai-4-h.org/schemas/evaluation-submission-v1.json#/$defs/outcome" } },
        "status": { "enum": ["pass", "fail", "review", "error"] },
        "error": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "suiteId", "suiteVersion", "suiteHash", "caseId", "caseTitle", "caseMessages", "target", "response", "startedAt", "completedAt", "latencyMs", "outcomes", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "suiteId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "suiteVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "suiteHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "caseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "caseTitle": { "type": "string", "minLength": 3, "maxLength": 120 },
        "caseMessages": { "type": "array", "minItems": 1, "items": { "$ref": "https://ai-4-h.org/schemas/evaluation-submission-v1.json#/$defs/message" } },
        "target": { "$ref": "https://ai-4-h.org/schemas/evaluation-submission-v1.json#/$defs/target" },
        "response": { "type": "string", "maxLength": 200000 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "latencyMs": { "type": "integer", "minimum": 0 },
        "promptTokens": { "type": "integer", "minimum": 0 },
        "completionTokens": { "type": "integer", "minimum": 0 },
        "outcomes": { "type": "array", "items": { "$ref": "https://ai-4-h.org/schemas/evaluation-submission-v1.json#/$defs/outcome" } },
        "status": { "enum": ["pass", "fail", "review", "error"] },
        "error": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "reviews": {
          "type": "array",
          "items": { "oneOf": [
            { "$ref": "https://ai-4-h.org/schemas/evaluation-submission-v1.json#/$defs/humanReview" },
            { "$ref": "https://ai-4-h.org/schemas/evaluation-submission-v1.json#/$defs/modelReview" }
          ] }
        },
        "executionType": { "enum": ["single_turn", "multi_turn"] },
        "outcomePolicy": { "const": "fail_on_any_turn" },
        "turnResults": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/turnResult" } },
        "firstFailedTurn": { "type": "integer", "minimum": 1, "maximum": 8 }
      },
      "allOf": [
        {
          "if": { "properties": { "executionType": { "const": "multi_turn" } }, "required": ["executionType"] },
          "then": {
            "properties": { "turnResults": true, "outcomePolicy": true },
            "required": ["turnResults", "outcomePolicy"]
          }
        }
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "createdAt", "completedAt", "status", "suiteSnapshots", "targets", "results"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "status": { "const": "completed" },
        "suiteSnapshots": { "type": "array", "minItems": 1, "items": { "$ref": "https://ai-4-h.org/schemas/evaluation-submission-v1.json#/$defs/suiteSnapshot" } },
        "targets": { "type": "array", "minItems": 1, "items": { "$ref": "https://ai-4-h.org/schemas/evaluation-submission-v1.json#/$defs/target" } },
        "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/result" } }
      }
    }
  }
}
